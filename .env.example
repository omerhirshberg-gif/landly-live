# GoLandly environment template. Copy to .env.local for development; set the
# same names in Vercel for BOTH Firebase projects (landly-dev and
# landly-be752) so the two environments stay in parity. Never commit values.

# --- Phone verification ---
# `true` turns the profile phone-change code on in production (off saves the
# number directly). In development it is on unless set to `false`.
PHONE_VERIFICATION_ENABLED=

# --- 019 delivery gateway (019sms.co.il) ---
# 019 only delivers the 6-digit code; GoLandly generates, hashes, rate-limits
# and verifies it. +972 numbers get an SMS, every other country a WhatsApp
# template. While these are empty the code is only logged to the `next dev`
# terminal (nothing is sent) and, in production, phone edits save directly.
SMS_019_USERNAME=
# Provide SMS_019_PASSWORD or SMS_019_TOKEN (one is enough).
SMS_019_PASSWORD=
SMS_019_TOKEN=
# Sender name shown to the member.
SMS_019_SENDER=
# `true` sends real messages from a non-production machine (production always
# does once the settings above are complete). Leave empty or `false` locally.
OTP_019_LIVE=
