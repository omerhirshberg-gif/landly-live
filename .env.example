# GoLandly environment template. Copy to .env.local for development; set the
# same names in Vercel for BOTH Firebase projects (landly-dev and
# landly-be752) so the two environments stay in parity. Never commit values.

# --- Phone verification ---
# `true` turns the profile phone-change code on in production (off saves the
# number directly). In development it is on unless set to `false`.
PHONE_VERIFICATION_ENABLED=

# --- 019 delivery gateway (019sms.co.il) ---
# 019 generates the 6-digit code and returns it; GoLandly hashes, rate-limits
# and verifies it. +972 numbers get an SMS, every other country a WhatsApp
# message from 019's own business line. While these are empty the code is only logged to the `next dev`
# terminal (nothing is sent) and, in production, phone edits save directly.
SMS_019_USERNAME=
# API token from 019's web UI (Settings > API Token Management); it expires on a
# fixed date, so rotate it before then. Use a separate token per environment.
SMS_019_TOKEN=
# Verified alphanumeric SMS sender (at most 11 letters/digits), e.g. GoLandly.
SMS_019_SENDER=
# `true` sends real messages from a non-production machine (production always
# does once the settings above are complete). Leave empty or `false` locally.
OTP_019_LIVE=

# --- Newsletter (Admin > Newsletter, sent through Resend) ---
# Sender of marketing campaigns; the domain must be verified in Resend.
# Defaults to "GoLandly <news@golandly.com>". Replies go to contact@golandly.com.
NEWSLETTER_FROM=
# Signs the one-click unsubscribe links (HMAC-SHA256). Generate with
# `openssl rand -base64 48`. Falls back to ADMIN_SESSION_SECRET when empty, but
# set a dedicated value so rotating the admin secret never breaks old links.
# Campaigns only go out for real from Production with RESEND_API_KEY set; DEV
# and local runs record a simulated send instead.
UNSUBSCRIBE_SECRET=

# --- Native app links (iOS universal links, Android App Links; lib/universalLinks.ts) ---
# Same values in the dev and production deployments. Unset, the matching
# /.well-known file answers 404.
# Apple Developer Team ID (10 characters).
APPLE_TEAM_ID=
# Comma-separated SHA-256 fingerprints of the Android app signing key (Play Console > App integrity).
ANDROID_SHA256_CERT_FINGERPRINTS=
# Store listings (lib/appLinks.ts): the numeric App Store id, and 1 once the Play listing is public.
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_GOOGLE_PLAY_LIVE=
