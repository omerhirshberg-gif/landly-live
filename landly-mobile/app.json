{
  "expo": {
    "name": "GoLandly",
    "slug": "landly-live",
    "scheme": "landly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "he",
          "ru",
          "fr",
          "es"
        ],
        "NSLocalNetworkUsageDescription": "GoLandly connects to the development server on your local network while the app is being developed.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.amitbd.landlyapp",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.golandly.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amitbd.landlyapp",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.golandly.com",
              "pathPrefix": "/offers/"
            },
            {
              "scheme": "https",
              "host": "www.golandly.com",
              "pathPrefix": "/member/vouchers/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc",
          "android": {
            "image": "./assets/splash-android-transparent.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-apple-authentication",
      "./plugins/withSceneLifecycle",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GoLandly uses Face ID so you can unlock the app quickly and keep your passes private."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "GoLandly uses Face ID so you can unlock the app quickly and keep your passes private.",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "forcesRTL": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoLandly uses your photos so you can choose a profile picture.",
          "cameraPermission": "GoLandly uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoLandly uses your location to show perks near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": false,
          "isAndroidMotionActivityEnabled": false
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    },
    "locales": {
      "en": "./locales/en.json",
      "he": "./locales/he.json",
      "ru": "./locales/ru.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json"
    },
    "extra": {
      "eas": {
        "projectId": "4bc2ad80-c0e8-4694-92d9-4dff1b57e93e"
      }
    },
    "owner": "amitbd1"
  }
}
