{
  "expo": {
    "name": "Landly",
    "slug": "landly-live",
    "scheme": "landly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "he"
        ],
        "NSLocalNetworkUsageDescription": "Landly connects to the development server on your local network while the app is being developed."
      },
      "bundleIdentifier": "com.amitbd.landlyapp",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amitbd.landlyapp",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc"
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/withSceneLifecycle",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Landly uses Face ID so you can unlock the app quickly and keep your passes private."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Landly uses Face ID so you can unlock the app quickly and keep your passes private.",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "forcesRTL": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Landly uses your photos so you can choose a profile picture.",
          "cameraPermission": "Landly uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Landly uses your location to show perks near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
