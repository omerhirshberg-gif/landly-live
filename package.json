{
  "name": "landly-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --exclude 'tests/emulator/**'",
    "test:emulator": "firebase emulators:exec --config firebase.test.json --project demo-landly-payments --only firestore \"vitest run tests/emulator --no-file-parallelism\"",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-phone-number-input": "^3.4.18",
    "resend": "^6.28.1",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
