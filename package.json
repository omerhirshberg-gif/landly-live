{
  "name": "landly-live",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "ios_saf >= 15",
    "safari >= 15"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mobile": "npm --prefix landly-mobile start",
    "test": "vitest run --exclude 'tests/emulator/**'",
    "test:emulator": "firebase emulators:exec --config firebase.test.json --project demo-landly-payments --only firestore \"vitest run tests/emulator --no-file-parallelism\"",
    "typecheck": "tsc --noEmit --incremental false",
    "check:apple": "node scripts/check-apple-oauth.mjs",
    "check:apple-key": "node scripts/check-apple-key.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vercel/analytics": "^2.0.1",
    "do-not-zip": "^1.0.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^14.9.0",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "1.55.0",
    "next": "^16.3.4",
    "ogg-opus-decoder": "^1.7.5",
    "passkit-generator": "^3.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-phone-number-input": "^3.4.18",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
