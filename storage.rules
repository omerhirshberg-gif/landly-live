rules_version = '2';

// Firebase Storage holds three things:
//  - member avatars, written by the web uploader
//    (components/profile/AvatarUploader.tsx) and the Expo picker
//    (landly-mobile/src/components/AvatarPicker.tsx) through uploadAvatar in
//    lib/firebase/avatar.ts. Both compress to a ≤1024px JPEG first, so the
//    2MB cap only stops a client that skipped that.
//  - offer banners, uploaded by admins through /api/admin/uploads (Admin SDK,
//    which these rules don't apply to: admins don't sign in with Firebase
//    Auth), so no client may write them.
//  - business logos, uploaded the same way (/api/admin/uploads, kind=logo)
//    and shown in the perk cards' rounded badge (PNG or JPEG); likewise admin-only writes.
service firebase.storage {
  match /b/{bucket}/o {

    // Readable by anyone holding the download URL (it's an <img> src on the
    // site and in the app). Only the member themselves may write it: signed
    // in, email verified, a customer (not a business account — same test as
    // isCustomer() in firestore.rules), an image, under 2MB. No deletes.
    match /avatars/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && !firestore.exists(/databases/(default)/documents/businesses/$(request.auth.uid))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Public (they're <img> srcs on perk cards); written only by the Admin SDK.
    match /banners/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Public (the perk cards' merchant badge); written only by the Admin SDK.
    match /logos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
