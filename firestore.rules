rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user may read and write only their own document, keyed by their auth UID.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default (production mode default, made explicit).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
