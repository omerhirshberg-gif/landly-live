rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Email+password signups stay unverified until they click the emailed
    // link; Google sign-ins are always verified. Existing email+password
    // customers were grandfathered by scripts/grandfather-email-verification.mjs.
    // Business logins are admin-created and unverified, but never touch the
    // customer-only data below that this gates.
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isCustomer() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/businesses/$(request.auth.uid));
    }

    // Each user may read and write only their own document, keyed by their auth UID.
    // create is allowed before verification: older app builds write this doc
    // right after sign-up (current ones leave it to /api/auth/send-verification,
    // with the first verified sign-in as fallback).
    // A missing own profile is readable before verification for signup.
    // Business membership always takes precedence over a customer profile.
    //
    // The account email and any pending email/phone change are server-only
    // (the /api/account change routes, Admin SDK): a client could otherwise
    // swap its email without opening the new inbox, or plant a pending
    // change. The member still reads them (the profile's amber notice), and
    // still writes `phone` directly from onboarding and settings; changes
    // from the profile screens go through the WhatsApp code when it's on.
    function serverOnlyUserKeys() {
      return ['pendingEmail', 'pendingEmailRequestedAt', 'pendingPhone', 'pendingPhoneRequestedAt'];
    }

    match /users/{userId} {
      allow create: if isCustomer() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverOnlyUserKeys());
      allow read: if isCustomer() && request.auth.uid == userId
        && (resource == null || isVerified());
      allow update: if isCustomer() && request.auth.uid == userId && isVerified()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserKeys().concat(['email']));
      allow delete: if isCustomer() && request.auth.uid == userId && isVerified();
    }

    // Email change links (SHA-256 of the token) and phone codes (hashed,
    // with their attempt count): read and written by the /api/account change
    // routes only. A readable token or code would let a member confirm an
    // inbox or number they don't own.
    match /emailChangeRequests/{userId} {
      allow read, write: if false;
    }
    match /phoneVerifications/{userId} {
      allow read, write: if false;
    }

    // Business accounts are created manually (Firebase Console) or via the
    // admin API route, both using the Admin SDK, which bypasses these rules
    // entirely. There is no field a business owner legitimately writes
    // client-side today (voucherStats is bumped only by the Tranzila
    // webhook, and businessName/category/location/businessId are all
    // admin-managed) — so, same as offers/vouchers, this is read-only for
    // the owner and denied for every write.
    match /businesses/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Publicly readable. All writes, including claimedCount, are admin-only
    // now: offer creation/edits go through a script or the admin API routes
    // using the Admin SDK, and claimedCount is bumped only by the Tranzila
    // webhook (lib/payments/claimOfferForOrder.ts) once a payment for that
    // offer is confirmed — never directly by a client.
    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }

    // One voucher per (user, offer), deterministic doc ID (`${uid}_${offerId}`).
    // Vouchers are created only by the Tranzila webhook (Admin SDK, bypasses
    // these rules) after payment is confirmed — a client can never create one
    // directly, since that would mean claiming an offer without paying for it.
    match /vouchers/{voucherId} {
      // Missing and foreign documents both deny direct reads. Owner-scoped
      // queries return an empty result when the customer has no voucher.
      allow read: if isCustomer() && isVerified()
        && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // One order per (user, offer), deterministic doc ID (`${uid}_${offerId}`).
    // Created by /api/payments/initiate and updated by
    // /api/payments/tranzila-webhook, both via the Admin SDK. The client only
    // ever reads its own order, to reflect live payment status on the
    // checkout success page (lib/firebase/orders.ts) — it never writes one.
    match /orders/{orderId} {
      allow read: if isCustomer() && request.auth.uid == resource.data.userId && isVerified();
      allow write: if false;
    }

    // Deny everything else by default (production mode default, made explicit).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
