rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Email+password signups stay unverified until they click the emailed
    // link; Google sign-ins are always verified. Existing email+password
    // customers were grandfathered by scripts/grandfather-email-verification.mjs.
    // Business logins are admin-created and unverified, but never touch the
    // customer-only data below that this gates.
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isCustomer() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/businesses/$(request.auth.uid));
    }

    // Each user may read and write only their own document, keyed by their auth UID.
    // create is allowed before verification: older app builds write this doc
    // right after sign-up (current ones leave it to /api/auth/send-verification,
    // with the first verified sign-in as fallback).
    // A missing own profile is readable before verification for signup.
    // Business membership always takes precedence over a customer profile.
    //
    // The account email and any pending email/phone change are server-only
    // (the /api/account change routes, Admin SDK): a client could otherwise
    // swap its email without opening the new inbox, or plant a pending
    // change. The member still reads them (the profile's amber notice), and
    // still writes `phone` directly from onboarding and settings; changes
    // from the profile screens go through the WhatsApp code when it's on,
    // and only that code sets `phoneVerified` (/api/account/verify-phone-otp).
    // The welcome-email flag is server-only too (/api/account/welcome-email):
    // clearing it would let a member have the email sent again. So is the
    // record of when and where a marketing opt-in was given (proof of
    // consent); `marketingOptIn` itself stays the member's to change.
    // So is the WebAuthn user handle the passkey routes create: a member who
    // could change it would orphan every passkey they've saved. And so is
    // the session cutoff below: a stolen session could otherwise clear it.
    function serverOnlyUserKeys() {
      return ['pendingEmail', 'pendingEmailRequestedAt', 'pendingPhone', 'pendingPhoneRequestedAt', 'phoneVerified',
        'welcomeEmailSent', 'welcomeEmailSentAt', 'marketingOptInAt', 'marketingOptInSource',
        'webauthnUserId', 'sessionsValidAfter'];
    }

    // "Sign out of all devices" and a verified email change revoke every
    // refresh token, but an ID token already issued stays valid here until
    // it expires (up to an hour): rules never see a revocation. Those routes
    // also stamp users/{uid}.sessionsValidAfter (lib/auth/sessionRevocation.ts),
    // and a token whose sign-in (auth_time, in seconds) came before it is
    // refused. No profile, or no stamp yet, means nothing was ever revoked.
    function sessionFreshFor(profile) {
      return !('sessionsValidAfter' in profile)
        || request.auth.token.auth_time * 1000 >= profile.sessionsValidAfter.toMillis();
    }

    function authFresh() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(profilePath) || sessionFreshFor(get(profilePath).data);
    }

    match /users/{userId} {
      allow create: if isCustomer() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverOnlyUserKeys());
      allow read: if isCustomer() && request.auth.uid == userId
        && (resource == null || (isVerified() && sessionFreshFor(resource.data)));
      allow update: if isCustomer() && request.auth.uid == userId && isVerified()
        && sessionFreshFor(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserKeys().concat(['email']));
      allow delete: if isCustomer() && request.auth.uid == userId && isVerified()
        && sessionFreshFor(resource.data);
    }

    // Push notification tokens, one document per device (lib/push/pushTokens.ts).
    // Architecture only for now: nothing writes these yet. The member manages
    // their own (verified, customers only); the document id is the token's
    // hash so re-registering a device overwrites rather than duplicates.
    // Sending happens server side (Admin SDK), never from a client.
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, delete: if isCustomer() && request.auth.uid == userId && isVerified() && authFresh();
      allow create, update: if isCustomer() && request.auth.uid == userId && isVerified() && authFresh()
        && request.resource.data.keys().hasOnly(['token', 'platform', 'provider', 'lang', 'createdAt', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 4096
        && request.resource.data.platform in ['ios', 'android', 'web']
        && request.resource.data.provider in ['expo', 'fcm']
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.updatedAt == request.time;
    }

    // The devices a member is signed in on (lib/account/sessionList.ts), one
    // document per device under a random id the device keeps. The member
    // lists and removes their own; a device writes only its name, platform
    // and the server's time, and keeps createdAt as first written. "Sign out
    // of all devices" clears them with the Admin SDK.
    match /users/{userId}/sessions/{sessionId} {
      allow read, delete: if isCustomer() && request.auth.uid == userId && isVerified() && authFresh();
      allow create: if isCustomer() && request.auth.uid == userId && isVerified() && authFresh()
        && sessionId.matches('^[A-Za-z0-9_-]{16,64}$')
        && request.resource.data.keys().hasOnly(['deviceName', 'platform', 'lastActiveAt', 'createdAt'])
        && validSession(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isCustomer() && request.auth.uid == userId && isVerified() && authFresh()
        && request.resource.data.keys().hasOnly(['deviceName', 'platform', 'lastActiveAt', 'createdAt'])
        && validSession(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validSession(data) {
      return data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80
        && data.platform in ['ios', 'android', 'web']
        && data.lastActiveAt == request.time;
    }

    // Email and phone change codes (hashed, with their attempt count): read
    // and written by the /api/account change routes only. A readable code
    // would let a member confirm an inbox or number they don't own.
    match /emailChangeRequests/{userId} {
      allow read, write: if false;
    }
    match /phoneVerifications/{userId} {
      allow read, write: if false;
    }

    // Passkeys (public keys, counters, names) and the one-time WebAuthn
    // challenges: read and written by the /api/auth/passkey and
    // /api/account/passkeys routes only (Admin SDK). Settings lists a
    // member's passkeys through that API, never directly.
    match /passkeys/{credentialId} {
      allow read, write: if false;
    }
    match /webauthnChallenges/{challengeId} {
      allow read, write: if false;
    }

    // The WhatsApp support bot's state (seen message ids, each number's menu
    // and escalation times) and transcripts: written by /api/webhooks/whatsapp
    // and read/written by the admin support inbox (/api/admin/whatsapp/*),
    // both through the Admin SDK only.
    match /whatsappInbound/{messageId} {
      allow read, write: if false;
    }
    match /whatsappConversations/{waId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Business accounts are created manually (Firebase Console) or via the
    // admin API route, both using the Admin SDK, which bypasses these rules
    // entirely. There is no field a business owner legitimately writes
    // client-side today (voucherStats is bumped only by the Tranzila
    // webhook, and businessName/category/location/businessId are all
    // admin-managed) — so, same as offers/vouchers, this is read-only for
    // the owner and denied for every write.
    match /businesses/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Publicly readable. All writes, including claimedCount, are admin-only
    // now: offer creation/edits go through a script or the admin API routes
    // using the Admin SDK, and claimedCount is bumped only by the Tranzila
    // webhook (lib/payments/claimOfferForOrder.ts) once a payment for that
    // offer is confirmed — never directly by a client.
    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }

    // One voucher per (user, offer), deterministic doc ID (`${uid}_${offerId}`).
    // Vouchers are created only by the Tranzila webhook (Admin SDK, bypasses
    // these rules) after payment is confirmed — a client can never create one
    // directly, since that would mean claiming an offer without paying for it.
    match /vouchers/{voucherId} {
      // Missing and foreign documents both deny direct reads. Owner-scoped
      // queries return an empty result when the customer has no voucher.
      allow read: if isCustomer() && isVerified()
        && request.auth.uid == resource.data.userId && authFresh();
      allow write: if false;
    }

    // One order per (user, offer), deterministic doc ID (`${uid}_${offerId}`).
    // Created by /api/payments/initiate and updated by
    // /api/payments/tranzila-webhook, both via the Admin SDK. The client only
    // ever reads its own order, to reflect live payment status on the
    // checkout success page (lib/firebase/orders.ts) — it never writes one.
    match /orders/{orderId} {
      allow read: if isCustomer() && request.auth.uid == resource.data.userId && isVerified() && authFresh();
      allow write: if false;
    }

    // The admin password-guessing throttle (lib/auth/adminLoginThrottle.ts):
    // read and written by /api/admin/verify-password only (Admin SDK).
    match /adminLoginThrottle/{key} {
      allow read, write: if false;
    }

    // Reverse-geocode answers (city per ~1 km cell and language), written and
    // read only by /api/geo/reverse through the Admin SDK.
    match /geoCache/{cellId} {
      allow read, write: if false;
    }

    // API usage counters per UTC month (lib/usage/recordUsage.ts): written by
    // the servers and read by /api/admin/usage (behind the admin session),
    // both through the Admin SDK. No client may read or write them.
    match /apiUsageStats/{month} {
      allow read, write: if false;
    }

    // Deny everything else by default (production mode default, made explicit).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
